  },
  "stages": [
    {
      "label": "Checkout Service"
    },
    {
      "label": "Unified Interface"
    },
    {
      "label": "Vendor Adapter"
    },
    {
      "label": "3rd-Party SDK"
    }
  ],
  "nodes": [
    {
      "id": "app",
      "type": "frontend",
      "label": "Order Checkout",
      "sublabel": "pay(amount_cents)",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "iface",
      "type": "backend",
      "label": "PaymentProcessor",
      "sublabel": "Target Interface",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "str_adp",
      "type": "backend",
      "label": "StripeAdapter",
      "sublabel": "cents to dollars",
      "stage": 2,
      "row": 0,
      "width": 130
    },
    {
      "id": "rzp_adp",
      "type": "backend",
      "label": "RazorpayAdapter",
      "sublabel": "USD to INR convert",
      "stage": 2,
      "row": 2,
      "width": 130
    },
    {
      "id": "stripe",
      "type": "external",
      "label": "Stripe Legacy API",
      "sublabel": "charge(dollars)",
      "stage": 3,
      "row": 0,
      "width": 130
    },
    {
      "id": "razorpay",
      "type": "external",
      "label": "Razorpay SDK",
      "sublabel": "execute(inr)",
      "stage": 3,
      "row": 2,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "app",
      "to": "iface",
      "label": "checkout"
    },
    {
      "from": "iface",
      "to": "str_adp",
      "label": "route stripe"
    },
    {
      "from": "iface",
      "to": "rzp_adp",
      "label": "route razorpay"
    },
    {
      "from": "str_adp",
      "to": "stripe",
      "label": "invoke SDK"
    },
    {
      "from": "rzp_adp",
      "to": "razorpay",
      "label": "invoke SDK"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Interface Harmonization",
      "items": [
        "Adapters translate incompatible signatures",
        "Client depends only on PaymentProcessor",
        "Adding 3rd payment partner needs zero core changes"
      ]
    }
  ]
}