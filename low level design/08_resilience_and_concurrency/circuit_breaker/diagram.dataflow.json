{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Circuit Breaker Fault Tolerance Data Flow",
    "output": "low level design/08_resilience_and_concurrency/circuit_breaker/diagram.html",
    "viewBox": [
      1080,
      720
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Client Call"
    },
    {
      "label": "Closed Normal"
    },
    {
      "label": "Open Cooldown"
    },
    {
      "label": "Half-Open Recovery"
    }
  ],
  "nodes": [
    {
      "id": "client",
      "type": "frontend",
      "label": "API Client",
      "sublabel": "charge_payment()",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "closed",
      "type": "security",
      "label": "CLOSED State",
      "sublabel": "Passes traffic",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "open",
      "type": "security",
      "label": "OPEN State",
      "sublabel": "Fail-Fast",
      "stage": 2,
      "row": 1,
      "width": 130
    },
    {
      "id": "half",
      "type": "backend",
      "label": "HALF-OPEN State",
      "sublabel": "Trial probe",
      "stage": 3,
      "row": 1,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "client",
      "to": "closed",
      "label": "request"
    },
    {
      "from": "closed",
      "to": "open",
      "label": "errors >= 3"
    },
    {
      "from": "open",
      "to": "half",
      "label": "cooldown ok"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Cascading Failure Prevention",
      "items": [
        "Fails fast when external service is degraded",
        "Gives downstream system breathing room to recover",
        "Self-heals automatically via probe requests"
      ]
    }
  ]
}