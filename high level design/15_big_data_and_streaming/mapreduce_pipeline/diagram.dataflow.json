{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "MapReduce Distributed Processing Data Flow",
    "output": "diagram.html",
    "viewBox": [
      1080,
      720
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Input Splits"
    },
    {
      "label": "Map Workers"
    },
    {
      "label": "Shuffle & Sort"
    },
    {
      "label": "Reduce Workers"
    }
  ],
  "nodes": [
    {
      "id": "splits",
      "type": "frontend",
      "label": "HDFS Files",
      "sublabel": "128MB chunks",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "map",
      "type": "backend",
      "label": "Map Workers",
      "sublabel": "(word, 1) emits",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "shuffle",
      "type": "security",
      "label": "Network Shuffle",
      "sublabel": "Hash partition key",
      "stage": 2,
      "row": 1,
      "width": 130
    },
    {
      "id": "red",
      "type": "database",
      "label": "Reduce Workers",
      "sublabel": "Sum and emit",
      "stage": 3,
      "row": 1,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "splits",
      "to": "map",
      "label": "read lines"
    },
    {
      "from": "map",
      "to": "shuffle",
      "label": "emit (k, 1)"
    },
    {
      "from": "shuffle",
      "to": "red",
      "label": "group by k"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Petabyte-Scale Parallelism",
      "items": [
        "Fault tolerance via task retry on worker node death",
        "Data locality: schedules map tasks on nodes hosting the data block",
        "Underpins Hadoop, Spark RDDs, and BigQuery analytics"
      ]
    }
  ]
}