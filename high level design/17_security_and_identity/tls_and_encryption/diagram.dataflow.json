      "row": 1,
      "width": 130
    },
    {
      "id": "aes",
      "type": "backend",
      "label": "AES-256-GCM",
      "sublabel": "Shared symmetric key",
      "stage": 2,
      "row": 1,
      "width": 130
    },
    {
      "id": "stream",
      "type": "database",
      "label": "Encrypted Pipe",
      "sublabel": "Forward secrecy",
      "stage": 3,
      "row": 1,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "client",
      "to": "server",
      "label": "hello"
    },
    {
      "from": "server",
      "to": "aes",
      "label": "derive key"
    },
    {
      "from": "aes",
      "to": "stream",
      "label": "cipher"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Zero-Trust Encryption",
      "items": [
        "TLS 1.3 achieves 1-RTT handshake latency",
        "Forward secrecy ensures past sessions cannot be decrypted if keys are compromised",
