    },
    {
      "label": "TLS 1.3 Handshake"
    },
    {
      "label": "Session Cipher"
    },
    {
      "label": "Secure Socket"
    }
  ],
  "nodes": [
    {
      "id": "client",
      "type": "frontend",
      "label": "Client Hello",
      "sublabel": "Keyshare + Supported Ciphers",
