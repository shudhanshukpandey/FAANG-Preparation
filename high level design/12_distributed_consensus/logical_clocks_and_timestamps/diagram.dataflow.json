    "output": "diagram.html",
    "viewBox": [
      1080,
      720
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Node A (Producer)"
    },
    {
      "label": "Network Pipe"
    },
    {
      "label": "Node B (Consumer)"
    },
    {
      "label": "Causal Order"
    }
  ],
  "nodes": [
    {
      "id": "node_a",
      "type": "frontend",
      "label": "Node A",
      "sublabel": "time = 1",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "net",
      "type": "backend",
      "label": "RPC Payload",
      "sublabel": "msg + clock=1",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "node_b",
      "type": "database",
      "label": "Node B",
      "sublabel": "max(time, msg)+1",
      "stage": 2,
      "row": 1,
      "width": 130
    },
    {
      "id": "order",
      "type": "security",
      "label": "Total Order",
      "sublabel": "Deterministic ordering",
      "stage": 3,
      "row": 1,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "node_a",
      "to": "net",
      "label": "send msg"
    },
    {
      "from": "net",
      "to": "node_b",
      "label": "deliver"
    },
    {
      "from": "node_b",
      "to": "order",
      "label": "reconcile"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Causal Consistency",
      "items": [
        "Solves clock drift across distributed physical NTP clocks",
        "Vector clocks detect concurrent writes without data loss",
        "Foundational to DynamoDB and Riak conflict resolution"
      ]
    }
  ]
}