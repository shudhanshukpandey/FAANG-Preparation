    "title": "LLM Inference Serving & Continuous Batching Data Flow",
    "output": "diagram.html",
    "viewBox": [
      1080,
      720
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase"
  },
  "stages": [
    {
      "label": "Prompt Ingestion"
    },
    {
      "label": "Continuous Scheduler"
    },
    {
      "label": "PagedAttention HBM"
    },
    {
      "label": "Autoregressive Stream"
    }
  ],
  "nodes": [
    {
      "id": "reqs",
      "type": "frontend",
      "label": "Client Streams",
      "sublabel": "Dynamic length prompts",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "batcher",
      "type": "security",
      "label": "vLLM Scheduler",
      "sublabel": "Iteration-level batching",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "paged_kv",
      "type": "database",
      "label": "Paged KV-Cache",
      "sublabel": "Virtual GPU memory",
      "stage": 2,
      "row": 1,
      "width": 130
    },
    {
      "id": "gpu",
      "type": "backend",
      "label": "GPU Matrix Compute",
      "sublabel": "Token-by-token emit",
      "stage": 3,
      "row": 1,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "reqs",
      "to": "batcher",
      "label": "inbound stream"
    },
    {
      "from": "batcher",
      "to": "paged_kv",
      "label": "allocate pages"
    },
    {
      "from": "paged_kv",
      "to": "gpu",
      "label": "decode step"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "5x-10x Higher Serving Throughput",
      "items": [
        "Continuous batching prevents GPU stalls while waiting for slow completions",
        "PagedAttention eliminates 60-80% wasted GPU VRAM memory",
        "Speculative decoding leverages small draft models to verify multiple tokens per step"
      ]
    }
  ]
}