      "width": 130
    },
    {
      "id": "part",
      "type": "security",
      "label": "Network Split",
      "sublabel": "Split-brain partition",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "cp",
      "type": "backend",
      "label": "CP Node (Etcd)",
      "sublabel": "Reject to keep sync",
      "stage": 2,
      "row": 0,
      "width": 130
    },
    {
      "id": "ap",
      "type": "backend",
      "label": "AP (Cassandra)",
      "sublabel": "Accept & reconcile",
      "stage": 2,
      "row": 2,
      "width": 130
    },
    {
      "id": "crdt",
      "type": "database",
      "label": "Eventual Store",
      "sublabel": "Vector Clock / LWW",
      "stage": 3,
      "row": 2,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "client",
      "to": "part",
      "label": "inbound"
    },
    {
      "from": "part",
      "to": "cp",
      "label": "partitioned"
    },
    {
      "from": "part",
      "to": "ap",
      "label": "partitioned"
    },
    {
      "from": "ap",
      "to": "crdt",
      "label": "eventual write"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "PACELC Trade-Off Matrix",
      "items": [
        "CP refuses writes when majority quorum cannot be reached",
        "AP accepts local write and reconciles via Last-Write-Wins or CRDT",
        "Network partitions are unavoidable at global scale"
      ]
    }
