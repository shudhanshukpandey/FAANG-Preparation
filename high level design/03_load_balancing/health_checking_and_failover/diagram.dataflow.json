      "label": "Traffic Stream",
      "sublabel": "Active callers",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "probe",
      "type": "security",
      "label": "Health Probe",
      "sublabel": "GET /healthz",
      "stage": 1,
      "row": 1,
      "width": 130
    },
    {
      "id": "s1",
      "type": "backend",
      "label": "Node 1 (Failing)",
      "sublabel": "2 failures",
      "stage": 2,
      "row": 0,
      "width": 130
    },
    {
      "id": "s2",
      "type": "backend",
      "label": "Node 2 (Healthy)",
      "sublabel": "200 OK",
      "stage": 2,
      "row": 2,
      "width": 130
    },
    {
      "id": "drain",
      "type": "database",
      "label": "Safe Drain",
      "sublabel": "100% to Node 2",
      "stage": 3,
      "row": 2,
      "width": 130
    }
  ],
  "flows": [
    {
      "from": "ingress",
      "to": "probe",
      "label": "intercept"
    },
    {
      "from": "probe",
      "to": "s1",
      "label": "probe fail"
    },
    {
      "from": "probe",
      "to": "s2",
      "label": "probe ok"
    },
    {
      "from": "s2",
      "to": "drain",
      "label": "drain ok"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Zero-Downtime Failover",
      "items": [
        "Active probes detect failure in seconds",
